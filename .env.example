# Copy this file to .env and fill in your local values.

# Required: MongoDB Atlas connection string used by src/database.py
MONGODB_URI=

# Required for Gemini matching used by src/matcher.py
GEMINI_API_KEY=

# Required for Groq matching used by src/matcher.py
GROQ_API_KEY=

# Optional: webhook for deadline notifications used by src/reminder.py
DISCORD_WEBHOOK_URL=