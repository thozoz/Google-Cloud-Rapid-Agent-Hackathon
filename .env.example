# Copy this file to .env and fill in your local values.

# Required: MongoDB Atlas connection string used by src/database.py
MONGODB_URI=

# AI Provider API Keys (used by src/matcher.py)
# At least one provider is required to run the app

# Google Gemini 2.0 Flash
GEMINI_API_KEY=

# Groq — Llama 3.3 70B
GROQ_API_KEY=

# OpenRouter — Qwen3 Next 80B (free tier)
OPENROUTER_API_KEY=

# Cerebras — Qwen 3 235B (free tier)
CEREBRAS_API_KEY=

# Ollama — Local inference (no API key needed, specify server endpoint)
# Include the full endpoint path: http://[host]:[port]/v1
# Default: http://localhost:11434/v1
# Examples:
#   Local:     http://localhost:11434/v1
#   Remote:    http://192.168.1.100:11434/v1
OLLAMA_ENDPOINT=http://localhost:11434/v1

# Ollama model to use (available models: gemma4:e4b, gemma4:26b, qwen3:14b, etc.)
# Run 'ollama list' to see installed models
# For GPUs with <8GB VRAM: use qwen3.5:9b or gemma4:e2b (smaller, faster)
# For GPUs with >8GB VRAM: use gemma4:e4b or gemma4:26b
OLLAMA_MODEL=gemma4:e4b

# Optional: Discord webhook for deadline notifications used by src/reminder.py
DISCORD_WEBHOOK_URL=